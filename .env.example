# Governing docs:
# - AGENTS.md
# - Implementation Plan.txt
# - docs\reference-baseline.md
# - docs\local-development.md
# Upstream docs:
# - https://bun.sh/docs/runtime/env
# - https://docs.docker.com/reference/cli/docker/compose/up/

# Core runtime identity and safety defaults.
HUMANIFY_ENVIRONMENT=development
HUMANIFY_SERVICE_NAME=humanify
HUMANIFY_RELEASE=local-dev
HUMANIFY_MAX_AUTOMATIC_ACTION=quarantine

# Discord bot and Bun API OAuth boot contract.
# Set HUMANIFY_SKIP_BOT=1 only if you intentionally want to run without the Discord bot.
HUMANIFY_SKIP_BOT=0
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:3211/auth/discord/callback
DISCORD_OAUTH_SCOPES=identify,guilds
HUMANIFY_BOT_REGISTER_COMMANDS=true
HUMANIFY_BOT_ENABLE_MEMBER_JOIN_SIGNALS=true
HUMANIFY_BOT_ENABLE_MESSAGE_SIGNALS=false

# API session and local browser shells.
HUMANIFY_API_HOST=0.0.0.0
HUMANIFY_API_PORT=3211
HUMANIFY_API_BASE_URL=http://127.0.0.1:3211
VITE_HUMANIFY_API_BASE_URL=http://127.0.0.1:3211
HUMANIFY_VERIFIER_BASE_URL=http://127.0.0.1:3212
HUMANIFY_SESSION_SECRET=replace-with-long-random-local-secret
HUMANIFY_SESSION_COOKIE_NAME=humanify_session
HUMANIFY_SESSION_TTL_SECONDS=43200
HUMANIFY_SECURE_COOKIES=false

# Verification provider surface.
HUMANIFY_ENABLED_VERIFICATION_PROVIDERS=self,world_id,didit
VITE_HUMANIFY_ENABLED_VERIFICATION_PROVIDERS=self,world_id,didit

# Didit one-time verification.
HUMANIFY_DIDIT_API_KEY=
HUMANIFY_DIDIT_WEBHOOK_SECRET=
HUMANIFY_DIDIT_WORKFLOW_ID=
HUMANIFY_DIDIT_API_BASE_URL=https://verification.didit.me

# Privado reusable-proof backend.
HUMANIFY_PRIVADO_VERIFIER_BASE_URL=
HUMANIFY_PRIVADO_ALLOWED_ISSUERS=
HUMANIFY_PRIVADO_CHAIN_ID=80002

# Local infrastructure ports and credentials.
# bun run dev derives HUMANIFY_POSTGRES_URL and HUMANIFY_REDIS_URL from the host/port values below when left blank.
HUMANIFY_DATABASE_URL=
HUMANIFY_POSTGRES_URL=
HUMANIFY_POSTGRES_HOST=127.0.0.1
HUMANIFY_POSTGRES_PORT=5432
HUMANIFY_POSTGRES_USER=humanify
HUMANIFY_POSTGRES_PASSWORD=humanify
HUMANIFY_POSTGRES_DB=humanify
HUMANIFY_REDIS_HOST=127.0.0.1
HUMANIFY_REDIS_PORT=6379
HUMANIFY_REDIS_URL=
HUMANIFY_ELECTRIC_PORT=5133
HUMANIFY_ELECTRIC_SECRET=humanify-electric-dev-secret
HUMANIFY_MINIO_ROOT_USER=humanify
HUMANIFY_MINIO_ROOT_PASSWORD=humanify-minio-secret
HUMANIFY_MINIO_API_PORT=9000
HUMANIFY_MINIO_CONSOLE_PORT=9001
HUMANIFY_R2_BUCKET=humanify-dev
HUMANIFY_QDRANT_HTTP_PORT=6333
HUMANIFY_QDRANT_GRPC_PORT=6334
HUMANIFY_GRAFANA_PORT=4300
HUMANIFY_GRAFANA_ADMIN_USER=admin
HUMANIFY_GRAFANA_ADMIN_PASSWORD=admin
HUMANIFY_TEMPORAL_PORT=7233
HUMANIFY_TEMPORAL_UI_PORT=8233
HUMANIFY_TEMPORAL_ADDRESS=127.0.0.1:7233
HUMANIFY_TEMPORAL_NAMESPACE=default
HUMANIFY_TEMPORAL_SCAN_TASK_QUEUE=humanify-member-scan

# Rust service bind addresses and internal callers.
HUMANIFY_INFERENCE_RS_BIND_ADDR=127.0.0.1:4101
HUMANIFY_LEARNING_RS_BIND_ADDR=127.0.0.1:4102
HUMANIFY_EVIDENCE_RS_BIND_ADDR=127.0.0.1:4103
HUMANIFY_TRUST_RS_BIND_ADDR=127.0.0.1:4104
HUMANIFY_LEARNING_SERVICE_URL=http://127.0.0.1:4102

# Temporal scan worker health and polling.
HUMANIFY_SCAN_WORKER_PORT=4210
HUMANIFY_SCAN_WORKER_POLL_INTERVAL_MS=3000

# Optional observability overrides.
HUMANIFY_SENTRY_DSN=
HUMANIFY_SENTRY_TRACES_SAMPLE_RATE=0
