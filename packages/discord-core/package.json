{
  "name": "@humanify/discord-core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun run typecheck",
    "lint": "bun run typecheck",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@humanify/contracts": "workspace:*",
    "discord.js": "^14.26.3"
  },
  "humanify": {
    "governingDocs": [
      "AGENTS.md",
      "Implementation Plan.txt",
      "docs\\architecture.md",
      "docs\\discord-bot.md",
      "docs\\api.md",
      "docs\\workspaces.md"
    ],
    "upstreamDocs": [
      "https://discord.js.org/docs/packages/discord.js/main",
      "https://discord.com/developers/docs/intro",
      "https://discord.com/developers/docs/topics/oauth2"
    ],
    "notes": "Discord core keeps bot execution thin by centralizing gateway intents, custom IDs, audit reasons, and capability-aware action checks."
  }
}
