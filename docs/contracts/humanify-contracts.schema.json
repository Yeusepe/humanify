{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanify.dev/schemas/contracts/humanify-contracts.schema.json",
  "title": "Humanify shared contracts",
  "description": "Canonical Bun-to-Rust wire contracts and shared domain objects for the initial Humanify Bun + Rust architecture.",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/RiskDecision"
    },
    {
      "$ref": "#/$defs/CaseOutcome"
    },
    {
      "$ref": "#/$defs/LearnedSignal"
    },
    {
      "$ref": "#/$defs/PolicyInput"
    },
    {
      "$ref": "#/$defs/InferenceRequest"
    },
    {
      "$ref": "#/$defs/InferenceResponse"
    },
    {
      "$ref": "#/$defs/EmbedRequest"
    },
    {
      "$ref": "#/$defs/EmbedResponse"
    },
    {
      "$ref": "#/$defs/SimilarityRequest"
    },
    {
      "$ref": "#/$defs/SimilarityResponse"
    },
    {
      "$ref": "#/$defs/RerankRequest"
    },
    {
      "$ref": "#/$defs/RerankResponse"
    },
    {
      "$ref": "#/$defs/ImageClassificationRequest"
    },
    {
      "$ref": "#/$defs/ImageClassificationResponse"
    }
  ],
  "$defs": {
    "SemVer": {
      "type": "string",
      "pattern": "^(0|[1-9]\\\\d*)\\.(0|[1-9]\\\\d*)\\.(0|[1-9]\\\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Action": {
      "type": "string",
      "enum": [
        "none",
        "watch",
        "verify",
        "quarantine",
        "timeout",
        "kick",
        "ban"
      ]
    },
    "ReasonCode": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "EvidenceRef": {
      "type": "string",
      "minLength": 1
    },
    "ReasonCodeList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ReasonCode"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "EvidenceRefList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "uniqueItems": true,
      "default": []
    },
    "RiskDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userId",
        "guildId",
        "score",
        "confidence",
        "reasonCodes",
        "recommendedAction",
        "evidenceRefs"
      ],
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1
        },
        "guildId": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reasonCodes": {
          "$ref": "#/$defs/ReasonCodeList"
        },
        "recommendedAction": {
          "$ref": "#/$defs/Action"
        },
        "evidenceRefs": {
          "$ref": "#/$defs/EvidenceRefList"
        },
        "expiresAt": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "CaseOutcomeType": {
      "type": "string",
      "enum": [
        "confirmed_scam",
        "confirmed_bot",
        "confirmed_hacked_account",
        "false_positive",
        "dismissed",
        "overturned"
      ]
    },
    "CaseOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "guildId",
        "subjectUserIdHash",
        "outcome",
        "confidence",
        "decidedBy",
        "decidedAt",
        "reasonCodes",
        "evidenceRefs"
      ],
      "properties": {
        "caseId": {
          "type": "string",
          "minLength": 1
        },
        "guildId": {
          "type": "string",
          "minLength": 1
        },
        "subjectUserIdHash": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "$ref": "#/$defs/CaseOutcomeType"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "decidedBy": {
          "type": "string",
          "minLength": 1
        },
        "decidedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "reasonCodes": {
          "$ref": "#/$defs/ReasonCodeList"
        },
        "evidenceRefs": {
          "$ref": "#/$defs/EvidenceRefList"
        }
      }
    },
    "LearnedSignalType": {
      "type": "string",
      "enum": [
        "text_similarity",
        "domain_reputation",
        "invite_reputation",
        "image_hash",
        "behavior_pattern",
        "reporter_reputation",
        "server_trust"
      ]
    },
    "LearnedSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "valueHash",
        "weight",
        "confidence",
        "sourceCaseIds",
        "falsePositiveCount",
        "truePositiveCount",
        "lastSeenAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/LearnedSignalType"
        },
        "valueHash": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "number"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sourceCaseIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "falsePositiveCount": {
          "type": "integer",
          "minimum": 0
        },
        "truePositiveCount": {
          "type": "integer",
          "minimum": 0
        },
        "lastSeenAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "expiresAt": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "CapabilityStatus": {
      "type": "string",
      "enum": [
        "ready",
        "degraded",
        "unavailable"
      ]
    },
    "TextEmbeddingPurpose": {
      "type": "string",
      "enum": [
        "query",
        "passage"
      ]
    },
    "TextInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "LearnedSignalCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "reasonCode",
        "sourceCaseIds",
        "text",
        "weight",
        "confidence",
        "falsePositiveCount",
        "truePositiveCount"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/LearnedSignalType"
        },
        "reasonCode": {
          "$ref": "#/$defs/ReasonCode"
        },
        "sourceCaseIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "valueHash": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "number"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "falsePositiveCount": {
          "type": "integer",
          "minimum": 0
        },
        "truePositiveCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ScoringPolicyInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serverSensitivity",
        "preferredContainmentAction",
        "suspiciousRoleIds",
        "trustedRoleIds",
        "enabledSignalFamilies",
        "allowCrossServerSignals"
      ],
      "properties": {
        "serverSensitivity": {
          "type": "string",
          "enum": [
            "low",
            "balanced",
            "high"
          ]
        },
        "preferredContainmentAction": {
          "type": "string",
          "enum": [
            "verify",
            "quarantine"
          ]
        },
        "suspiciousRoleIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "trustedRoleIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "enabledSignalFamilies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "allowCrossServerSignals": {
          "type": "boolean"
        }
      }
    },
    "InferenceEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "occurredAt"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "join",
            "message",
            "report",
            "verification_update",
            "manual_review"
          ]
        },
        "occurredAt": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "InferenceFeatures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accountAgeHours",
        "joinedAgeMinutes",
        "hasAvatar",
        "hasBanner",
        "normalizedDomains",
        "mentionCountLastMinute",
        "duplicateMessageCount"
      ],
      "properties": {
        "accountAgeHours": {
          "type": "number",
          "minimum": 0
        },
        "joinedAgeMinutes": {
          "type": "number",
          "minimum": 0
        },
        "hasAvatar": {
          "type": "boolean"
        },
        "hasBanner": {
          "type": "boolean"
        },
        "firstMessageDelaySeconds": {
          "type": "number",
          "minimum": 0
        },
        "messageText": {
          "type": "string",
          "minLength": 1
        },
        "messageTextHash": {
          "type": "string",
          "minLength": 1
        },
        "normalizedDomains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "inviteCodeHash": {
          "type": "string",
          "minLength": 1
        },
        "mentionCountLastMinute": {
          "type": "integer",
          "minimum": 0
        },
        "duplicateMessageCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "InferenceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestId",
        "guildId",
        "subjectUserId",
        "event",
        "features",
        "evidenceRefs",
        "policyInput"
      ],
      "properties": {
        "contractVersion": {
          "$ref": "#/$defs/SemVer"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "guildId": {
          "type": "string",
          "minLength": 1
        },
        "subjectUserId": {
          "type": "string",
          "minLength": 1
        },
        "event": {
          "$ref": "#/$defs/InferenceEvent"
        },
        "features": {
          "$ref": "#/$defs/InferenceFeatures"
        },
        "evidenceRefs": {
          "$ref": "#/$defs/EvidenceRefList"
        },
        "policyInput": {
          "$ref": "#/$defs/ScoringPolicyInput"
        },
        "learnedSignalCandidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LearnedSignalCandidate"
          },
          "default": []
        }
      }
    },
    "InferenceResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestId",
        "modelVersion",
        "decision",
        "learnedSignals",
        "warnings"
      ],
      "properties": {
        "contractVersion": {
          "$ref": "#/$defs/SemVer"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "modelVersion": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "$ref": "#/$defs/RiskDecision"
        },
        "learnedSignals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LearnedSignal"
          },
          "default": []
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "EmbedRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestId",
        "purpose",
        "inputs"
      ],
      "properties": {
        "contractVersion": {
          "$ref": "#/$defs/SemVer"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "$ref": "#/$defs/TextEmbeddingPurpose"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TextInput"
          },
          "minItems": 1
        }
      }
    },
    "EmbeddingRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valueHash",
        "vector"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "valueHash": {
          "type": "string",
          "minLength": 1
        },
        "vector": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1
        }
      }
    },
    "EmbedResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestId",
        "capabilityStatus",
        "modelVersion",
        "dimensions",
        "embeddings",
        "warnings"
      ],
      "properties": {
        "contractVersion": {
          "$ref": "#/$defs/SemVer"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "capabilityStatus": {
          "$ref": "#/$defs/CapabilityStatus"
        },
        "modelVersion": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "integer",
          "minimum": 1
        },
        "embeddings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EmbeddingRecord"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "SimilarityRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestId",
        "query",
        "candidates"
      ],
      "properties": {
        "contractVersion": {
          "$ref": "#/$defs/SemVer"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "query": {
          "$ref": "#/$defs/TextInput"
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LearnedSignalCandidate"
          },
          "minItems": 1
        },
        "topK": {
          "type": "integer",
          "minimum": 1
        },
        "minScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "SimilarityMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "reasonCode",
        "sourceCaseIds",
        "valueHash",
        "score",
        "adjustedWeight",
        "adjustedConfidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/LearnedSignalType"
        },
        "reasonCode": {
          "$ref": "#/$defs/ReasonCode"
        },
        "sourceCaseIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "valueHash": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "adjustedWeight": {
          "type": "number"
        },
        "adjustedConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "SimilarityResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestId",
        "capabilityStatus",
        "modelVersion",
        "dimensions",
        "queryHash",
        "matches",
        "warnings"
      ],
      "properties": {
        "contractVersion": {
          "$ref": "#/$defs/SemVer"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "capabilityStatus": {
          "$ref": "#/$defs/CapabilityStatus"
        },
        "modelVersion": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "integer",
          "minimum": 1
        },
        "queryHash": {
          "type": "string",
          "minLength": 1
        },
        "matches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SimilarityMatch"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "RerankRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestId",
        "query",
        "documents"
      ],
      "properties": {
        "contractVersion": {
          "$ref": "#/$defs/SemVer"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "query": {
          "$ref": "#/$defs/TextInput"
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LearnedSignalCandidate"
          },
          "minItems": 1
        },
        "topK": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "RerankResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reasonCode",
        "sourceCaseIds",
        "valueHash",
        "score"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "reasonCode": {
          "$ref": "#/$defs/ReasonCode"
        },
        "sourceCaseIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "valueHash": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        }
      }
    },
    "RerankResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestId",
        "capabilityStatus",
        "modelVersion",
        "dimensions",
        "results",
        "warnings"
      ],
      "properties": {
        "contractVersion": {
          "$ref": "#/$defs/SemVer"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "capabilityStatus": {
          "$ref": "#/$defs/CapabilityStatus"
        },
        "modelVersion": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "integer",
          "minimum": 1
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RerankResult"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "ImageClassificationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestId",
        "evidenceRefs"
      ],
      "properties": {
        "contractVersion": {
          "$ref": "#/$defs/SemVer"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRefs": {
          "$ref": "#/$defs/EvidenceRefList"
        }
      }
    },
    "ImageClassificationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestId",
        "capabilityStatus",
        "modelVersion",
        "evidenceRefs",
        "warnings"
      ],
      "properties": {
        "contractVersion": {
          "$ref": "#/$defs/SemVer"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "capabilityStatus": {
          "$ref": "#/$defs/CapabilityStatus"
        },
        "modelVersion": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRefs": {
          "$ref": "#/$defs/EvidenceRefList"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "PolicyInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "riskDecision",
        "serverPolicy",
        "capabilityContext",
        "caseContext"
      ],
      "properties": {
        "riskDecision": {
          "$ref": "#/$defs/RiskDecision"
        },
        "serverPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxAutomaticAction",
            "allowAutoBan",
            "verificationRequiredAtOrAbove",
            "quarantineAtOrAbove"
          ],
          "properties": {
            "maxAutomaticAction": {
              "$ref": "#/$defs/Action"
            },
            "allowAutoBan": {
              "type": "boolean"
            },
            "verificationRequiredAtOrAbove": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "quarantineAtOrAbove": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "timeoutAtOrAbove": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "kickAtOrAbove": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "banAtOrAbove": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          }
        },
